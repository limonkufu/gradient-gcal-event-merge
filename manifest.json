{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Grad Merge",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.3.0",
  "homepage_url": "https://github.com/limonkufu/gradient-gcal-event-merge",
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": ["events.user.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calendar Gradient Settings",
    "default_icon": {
      "48": "icon.png",
      "128": "icon-large.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon-large.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
